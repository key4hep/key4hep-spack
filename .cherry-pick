git remote add jmcarcell https://github.com/jmcarcell/spack-packages || true
git fetch jmcarcell -q

# root: allow +ipo (patch from jmcarcell/spack-packages@9af230f2, applied with targeted
# edits rather than a cherry-pick so that newer upstream changes to root are kept)
ROOT_PKG=repos/spack_repo/builtin/packages/root/package.py
git checkout 9af230f21396b8e99eefab09a586f51120ab186a -- repos/spack_repo/builtin/packages/root/ipo.patch
sed -i '0,/^    if _is_macos:/s//    patch("ipo.patch")\n\n    if _is_macos:/' ${ROOT_PKG}
sed -i 's/^\( *\)conflicts("+ipo",/\1# conflicts("+ipo",/' ${ROOT_PKG}

# root: use a builtin civetweb (same as jmcarcell/spack-packages@eed88ee4)
sed -i 's/^\( *\)depends_on("civetweb +shared", when="+http")/\1# depends_on("civetweb +shared", when="+http")/' ${ROOT_PKG}
sed -i 's/define("builtin_civetweb", False)/define("builtin_civetweb", True)/' ${ROOT_PKG}

# madgraph5amc: add changes to install models (https://github.com/spack/spack-packages/pull/110, closed upstream)
curl -sSfL https://patch-diff.githubusercontent.com/raw/spack/spack-packages/pull/110.diff | patch -p1

# py_gosam: try a fix for the build, which is probably not correct
# git cherry-pick 45e1d831afc38948a89966c01f6ffa57201d8c0d -X theirs --no-commit

# dd4hep: set CMAKE_INSTALL_LIBDIR to lib
git cherry-pick e79552a5782ae4967f1acb15e7bf1a31660f0eea -X theirs --no-commit

# herwig3: the bundled LoopTools has integer constants out of range for gfortran (seen on aarch64)
sed -i 's/^\( *\)flags.append("-std=legacy")/&\n\1flags.append("-fno-range-check")/' repos/spack_repo/builtin/packages/herwig3/package.py
